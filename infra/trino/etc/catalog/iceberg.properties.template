# Trino <-> Iceberg REST Catalog <-> MinIO wiring. Rake renders the local
# credentials into an ignored file under .local/ before starting the stack.
connector.name=iceberg

iceberg.catalog.type=rest
iceberg.rest-catalog.uri=http://iceberg-catalog:8181
iceberg.rest-catalog.warehouse=s3://__PCL_ICEBERG_BUCKET__/warehouse/

fs.native-s3.enabled=true
s3.endpoint=http://minio:9000
s3.region=__PCL_MINIO_REGION__
s3.path-style-access=true
s3.aws-access-key=__PCL_MINIO_ROOT_USER__
s3.aws-secret-key=__PCL_MINIO_ROOT_PASSWORD__

iceberg.file-format=PARQUET
iceberg.compression-codec=ZSTD
iceberg.register-table-procedure.enabled=true
