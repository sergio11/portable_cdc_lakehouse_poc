# --- Postgres (operational source, WAL source for Debezium) -------------------
PCL_POSTGRES_DB=pcl
PCL_POSTGRES_USER=postgres
# Local-only development credential. Copy to .env and change; never commit.
PCL_POSTGRES_PASSWORD=pcl_local_dev
PCL_POSTGRES_PORT=15432

# --- Kafka (CDC transport) ----------------------------------------------------
# Fixed cluster id so the KRaft metadata log is reproducible across restarts.
PCL_KAFKA_CLUSTER_ID=pcl-kraft-cluster-01

# --- Kafka Connect / Debezium ------------------------------------------------
PCL_CONNECT_PORT=8083

# --- Trino (read-only serving layer over the Iceberg tables) ------------------
PCL_TRINO_PORT=8080
PCL_FLINK_WEB_PORT=8081

# --- Apache Spark (batch transformation: DDL, MERGE, replay) ------------------
PCL_SPARK_VERSION=3.5.9
PCL_SPARK_ICEBERG_VERSION=1.11.0
PCL_SPARK_DRIVER_MEMORY=1g

# --- MinIO (S3-compatible Iceberg warehouse) ---------------------------------
PCL_MINIO_API_PORT=9000
PCL_MINIO_CONSOLE_PORT=9001
PCL_MINIO_ROOT_USER=pcladmin
# Local-only development credential. Change in .env; never commit real secrets.
PCL_MINIO_ROOT_PASSWORD=pcl_local_minio_dev
PCL_ICEBERG_BUCKET=pcl-warehouse
PCL_MINIO_REGION=us-east-1

# --- Apache Polaris (Iceberg REST catalog, Postgres metastore) ----------------
PCL_POLARIS_VERSION=1.8.0
PCL_POLARIS_CLIENT_ID=root
# Local-only development credential. Change in .env; never commit real secrets.
PCL_POLARIS_CLIENT_SECRET=s3cr3t
PCL_ICEBERG_CATALOG_PORT=8181
PCL_POLARIS_HEALTH_PORT=8182

# --- Beam pipeline identity ---------------------------------------------------
# Injected into the Beam submitter container by `rake pipeline:direct` or `rake pipeline:flink`.
PCL_SOURCE_ID=pg-local-1
PCL_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
PCL_CDC_TOPIC=pcl.public.orders
PCL_ICEBERG_CATALOG_URI=http://polaris:8181/api/catalog
PCL_ICEBERG_WAREHOUSE=pcl
PCL_MINIO_ENDPOINT=http://minio:9000
PCL_PRIMARY_KEY_COLUMNS=order_id
PCL_WRITE_FREQUENCY_SECONDS=10
# Use a positive value for a bounded local fixture run; 0 means continuous streaming.
PCL_MAX_RECORDS=0
